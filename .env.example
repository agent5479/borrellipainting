# Local hash(es) for /office login (never commit .env.local).
# Comma-separate if you have more than one password.
# Generate with:
#   printf '%s' 'your-password' | sha256sum
# Or on Windows PowerShell:
#   [BitConverter]::ToString((New-Object Security.Cryptography.SHA256Managed).ComputeHash([Text.Encoding]::UTF8.GetBytes('your-password'))).Replace('-','').ToLower()
VITE_QUOTES_PASSWORD_HASH=
